{
  "name": "prompt-architect-vscode",
  "displayName": "Prompt Architect VSCode",
  "description": "Integrates Prompt Architect with VS Code for prompt refinement.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:promptArchitect.refine"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "promptArchitect.refine",
        "title": "Prompt Architect: Refine Selected Prompt"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTests.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.x",
    "eslint": "^8.40.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.1.3",
    "@vscode/test-electron": "^2.3.2"
  },
  "dependencies": {
    "axios": "^1.7.2"
  }
}
